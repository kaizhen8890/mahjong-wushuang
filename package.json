{
  "name": "sites-project",
  "version": "1.1.0-beta.46",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:offline-manifest": "node scripts/build-offline-manifest.mjs",
    "android:sync": "cap sync android",
    "ios:sync": "node scripts/capacitor-cli.cjs sync ios",
    "ios:prepare": "pnpm exec tsc --noEmit && pnpm build && pnpm build:offline-manifest && pnpm ios:sync",
    "ios:check": "node scripts/check-ios-project.mjs",
    "ios:build:simulator": "node scripts/build-ios.mjs",
    "test:core": "node scripts/test-core.mjs",
    "android:apk": "node scripts/android-build.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "android:verify": "node scripts/android-verify.mjs",
    "test:build": "python -m unittest discover -s tests/build -p test_*.py",
    "test:content": "python tools/build/content_contract.py"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
